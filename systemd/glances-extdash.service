[Unit]
Description=Glances Web Server (ExtDash)
After=network.target

[Service]
# Шлях до glances: за README це venv ~/extdash-venv. Якщо Glances встановлено інакше, змініть шлях.
ExecStart=%h/extdash-venv/bin/glances -w -B 127.0.0.1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
