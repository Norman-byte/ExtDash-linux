[Unit]
Description=PC Dashboard Server (ExtDash)
After=network.target glances-extdash.service
Requires=glances-extdash.service

[Service]
# Шлях до Python: за README це venv ~/extdash-venv. Якщо залежності встановлено інакше, змініть шлях.
ExecStart=%h/extdash-venv/bin/python %h/ExtDash/pc_dashboard_server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
